{
  "name": "clearline",
  "version": "0.1.0",
  "private": true,
  "description": "Contract-driven healthcare data platform (synthetic data only)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/cli.ts migrate",
    "assistant:index": "tsx src/cli.ts assistant-index",
    "assistant:eval": "tsx scripts/assistant-eval.ts",
    "seed": "tsx scripts/seed.ts",
    "dev:api": "tsx src/main.ts",
    "dev:worker": "tsx src/worker-main.ts",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker-main.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:scenarios",
    "test:unit": "node --import tsx --test --test-reporter=spec test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-reporter=spec test/integration/*.test.ts",
    "test:scenarios": "node -e \"require('fs').mkdirSync('test-results',{recursive:true});require('fs').rmSync('test-results/evidence.md',{force:true})\" && node --import tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/scenarios.junit.xml test/scenarios/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 --test-reporter=spec test/e2e/*.test.ts",
    "test:all": "npm test && npm run native:build && npm run test:e2e",
    "docs:api": "tsx scripts/gen-api-docs.ts",
    "docs:examples": "tsx scripts/gen-examples.ts",
    "docs:reference": "tsx scripts/gen-reference-docs.ts",
    "test:mutation": "tsx scripts/mutation-check.ts",
    "native:build": "cargo build --release --manifest-path native/Cargo.toml",
    "native:test": "cargo test --manifest-path native/Cargo.toml -p clearline-client",
    "native:run": "cargo run --release --manifest-path native/Cargo.toml --bin clearline --",
    "benchmark:query": "tsx scripts/benchmark-query.ts",
    "benchmark:analytics": "tsx scripts/benchmark-analytics.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@huggingface/transformers": "^4.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pgsql-parser": "^17.9.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
