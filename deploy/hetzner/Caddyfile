# Automatic HTTPS (Let's Encrypt) when SITE_ADDRESS is a domain whose DNS points at this server and ports 80/443 are open.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Prometheus metrics expose tenant ids and source names: not for the public internet. Scrape from inside the host/network instead.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy api:8080 {
		# The API sets its own security headers; Caddy adds only the transport one.
		header_down Strict-Transport-Security "max-age=31536000"
	}
}
